# Local preview: start only the app service, then open http://127.0.0.1:8080.
# On DigitalOcean, replace localhost with your actual hostname, e.g.
# DOMAIN=soilmate.example.com
# Use a hostname only, without https:// or a trailing slash.
DOMAIN=localhost

# Optional version tag for local Docker images; keep latest to start.
IMAGE_TAG=latest
